{
  "name": "notification-preferences-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "migrate": "NODE_OPTIONS=\"--import tsx\" npx sequelize-cli db:migrate",
    "rollback": "NODE_OPTIONS=\"--import tsx\" npx sequelize-cli db:migrate:undo",
    "seed": "NODE_OPTIONS=\"--import tsx\" npx sequelize-cli db:seed:all",
    "unseed": "NODE_OPTIONS=\"--import tsx\" npx sequelize-cli db:seed:undo:all",
    "test": "NODE_ENV=test npm run migrate && jest"
  },
  "dependencies": {
    "next": "16.2.7",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "sequelize-cli": "^6.6.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
